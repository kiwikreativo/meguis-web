---
import "../assets/app.css";
import Navbar from "../components/Navbar.astro";
interface Props { title?: string; description?: string; canonical?: string; ogTitle?: string; ogDescription?: string; ogUrl?: string; ogImage?: string; structuredData?: Record<string, unknown>; }
const { title="Agencia Aduanera en Puerto Cortés, Honduras | Meguis", description="Meguis Import & Export ofrece despacho aduanero, logística integral y transporte terrestre de carga en Honduras.", canonical="https://www.meguis.net/", ogTitle="Meguis - Logística y Aduanas en Honduras", ogDescription=description, ogUrl=canonical, ogImage="https://www.meguis.net/og-image.webp", structuredData:pageStructuredData }=Astro.props;
const structuredData=pageStructuredData??{"@context":"https://schema.org","@type":"ProfessionalService","@id":"https://meguis.net/#business",name:"Meguis Import & Export",url:"https://www.meguis.net/",telephone:"+504 96380889",address:{"@type":"PostalAddress",addressLocality:"Puerto Cortés",addressCountry:"HN"},areaServed:{"@type":"Country",name:"Honduras"}};
---
<!doctype html><html lang="es-HN"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><meta name="author" content="Meguis Import & Export"/><meta name="theme-color" content="#010d1c"/><link rel="canonical" href={canonical}/><link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png"/><link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png"/><link rel="manifest" href="/site.webmanifest"/><meta property="og:title" content={ogTitle}/><meta property="og:description" content={ogDescription}/><meta property="og:type" content="website"/><meta property="og:url" content={ogUrl}/><meta property="og:image" content={ogImage}/><script type="application/ld+json" set:html={JSON.stringify(structuredData)}/><title>{title}</title></head><body><Navbar/><slot/></body></html>
<style is:global>
 @import url("https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700;800&display=swap");
 :root{color-scheme:dark;font-family:"Geist",system-ui,sans-serif;scroll-behavior:smooth}*{box-sizing:border-box}html,body{margin:0;width:100%;background:#010d1c}body{overflow-x:hidden}button,a{font:inherit}::selection{background:#ff4b17;color:#fff}
</style>
