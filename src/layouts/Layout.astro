---
import "../assets/app.css";
import Navbar from "../components/Navbar.astro";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogUrl?: string;
  ogImage?: string;
  structuredData?: Record<string, unknown>;
}

const {
  title = "Agencia Aduanera en Puerto Cortés, Honduras | Meguis",
  description = "Meguis Import & Export es una agencia aduanera ubicada en Puerto Cortés, Honduras que ofrece servicios de despacho aduanero, logística integral y transporte terrestre de carga",
  canonical = "https://www.meguis.net/",
  ogTitle = "Meguis - Logística y Aduanas en Honduras",
  ogDescription = "Servicios expertos en aduanas, logística y manejo de mercancías para importación y exportación en Honduras.",
  ogUrl = canonical,
  ogImage = "https://www.meguis.net/og-image.webp",
  structuredData: pageStructuredData,
} = Astro.props;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": "https://meguis.net/#business",
  name: "Meguis Import & Export",
  url: "https://www.meguis.net/",
  telephone: "+504 96380889",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Puerto Cortés",
    addressCountry: "HN",
  },
  areaServed: {
    "@type": "Country",
    name: "Honduras",
  },
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Servicios de logística y aduanas",
    itemListElement: [
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Transporte Terrestre de Carga en Honduras",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Logística Integral para Importadores en Honduras",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Asesoría Legal Aduanera en Honduras",
        },
      },
    ],
  },
};

const resolvedStructuredData = pageStructuredData ?? structuredData;
---

<!doctype html>
<html lang="es-HN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="Agencia aduanera en Puerto Cortés, Honduras, con despacho aduanero, logística integral, transporte terrestre de carga"
    />
    <meta
      name="author"
      content="Meguis | Logística, Aduanas y tranporte en Honduras."
    />
    <link rel="canonical" href={canonical} />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link
      rel="stylesheet"
      href="https://unpkg.com/aos@3.0.0-beta.6/dist/aos.css"
    />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:image" content={ogImage} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(resolvedStructuredData)}
    />
    <script
      src="https://kit.fontawesome.com/509c179d58.js"
      crossorigin="anonymous"></script>

    <title>{title}</title>
  </head>
  <body>
    <Navbar />
    <main>
      <slot />
    </main>
    <script type="module">
      import AOS from "https://unpkg.com/aos@3.0.0-beta.6/dist/aos.mjs";

      AOS.init({
        duration: 800,
        once: false,
        offset: 100,
        easing: "ease-in-out",
      });
    </script>
  </body>
</html>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap");
  html,
  body {
    margin: 0;
    padding: 0;
    width: 100%;
    background-color: #010d1c;
    font-family: "Inter", sans-serif;
  }

  main {
    display: flex;
    flex-direction: column;
    width: 100%;
  }
</style>
