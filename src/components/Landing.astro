---
import Footer from "./Footer.astro";
import ExperienceInline from "../assets/meguis-experience-inline.webp";
import LogisticsIntegral from "../assets/meguis-logistics-integral.webp";
import GroundTransport from "../assets/meguis-transporte-terrestre.webp";
import DottedAmericasMap from "./DottedAmericasMap.astro";
import {
  ArrowDownRight,
  ArrowUpRight,
  Check,
  ChevronLeft,
  ChevronRight,
  FileCheck2,
  Ship,
  Truck,
} from "@lucide/astro";
const whatsapp =
  "https://api.whatsapp.com/send?phone=50496380889&text=Hola%2C%20me%20gustar%C3%ADa%20solicitar%20informaci%C3%B3n%20sobre%20sus%20servicios%20de%20despacho%20aduanero%20y%20log%C3%ADstica%20integral.";
const testimonials = [
  {
    name: "Aldo Obregón",
    text: "Los mejores en desaduanaje. 100% confiables.",
  },
  {
    name: "César Mayén",
    text: "Rapidez en desaduanaje y, sobre todo, una comunicación constante.",
  },
  {
    name: "Guillermo Obando",
    text: "Excelente servicio y muy responsables. Me ayudaron con todo el proceso de importación y nacionalización, siempre explicando cada paso. Se nota la experiencia en temas aduaneros; muy recomendados.",
  },
];
---

<main class="landing" data-landing>
  <section class="hero" id="inicio">
    <div class="hero-media" aria-hidden="true"></div><div
      class="hero-wash"
      aria-hidden="true"
    >
    </div>
    <div class="hero-inner shell">
      <p class="location">Puerto Cortés, Honduras</p><h1>
        Su carga cruza fronteras. <em>Nosotros abrimos el camino.</em>
      </h1><p class="hero-copy">
        Más de 35 años resolviendo trámites aduaneros y logística para carga que
        llega de cualquier parte del mundo.
      </p><div class="hero-actions">
        <a
          class="button primary"
          href={whatsapp} data-seo-event="whatsapp_click"
          target="_blank"
          rel="noreferrer">Solicitar cotización <ArrowUpRight size={18} /></a
        ><a class="button ghost" href="#servicios"
          >Explorar servicios <ArrowDownRight size={18} /></a>
      </div>
    </div>
    <div class="hero-aside">
      <span>Logística integral</span><span>Aduanas</span><span>Transporte</span>
    </div><a class="scroll-cue" href="#confianza" aria-label="Continuar"
      ><ArrowDownRight size={20} /></a
    >
  </section>
  <section class="trust" id="confianza">
    <div class="shell trust-grid">
      <p>
        Una trayectoria construida coordinando cada detalle con claridad y
        responsabilidad.
      </p><div><strong>35+</strong><span>Años en el mercado</span></div><div>
        <strong>5,000+</strong><span>Gestiones en aduanas</span>
      </div><div><strong>100%</strong><span>Eficiencia operativa</span></div>
    </div>
  </section>
  <section class="intro chapter">
    <div class="shell intro-grid">
      <p class="kicker">Experiencia que mueve</p><div>
        <h2>
          Una operación compleja puede sentirse <span
            class="inline-image"
            role="img"
            aria-label="Contenedores y grúas coordinados en una terminal portuaria."
            style={`background-image:url("${ExperienceInline.src}")`}></span> sorprendentemente
          simple.
        </h2><div class="intro-copy">
          <p>
            Coordinamos la gestión aduanera, el transporte terrestre y la
            nacionalización de mercancías desde Puerto Cortés hasta su destino
            final.
          </p><a href="#proceso"
            >Conocer el proceso <ArrowDownRight size={18} /></a>
        </div>
      </div>
    </div>
  </section>
  <section class="services chapter" id="servicios">
    <div class="shell">
      <div class="services-head">
        <p class="kicker">Soluciones integrales</p><h2>
          Todo lo que su carga necesita, conectado en una sola operación.
        </h2>
      </div><div class="service-grid">
        <a class="service-card featured" href="/logistica-integral/"
          ><div
            class="service-image port"
            aria-hidden="true"
            style={`background-image:url("${LogisticsIntegral.src}")`}
          >
          </div><div class="service-content">
            <Ship size={30} /><span class="service-index">01</span><h3>
              Logística integral para importadores
            </h3><p>
              Gestión aduanera, transporte terrestre y nacionalización desde
              Puerto Cortés hasta el destino final.
            </p><span class="service-link"
              >Ver servicio <ArrowUpRight size={18} /></span>
          </div></a
        >
        <a class="service-card wide" href="/transporte-terrestre/"
          ><div class="service-content">
            <Truck size={30} /><span class="service-index">02</span><h3>
              Transporte terrestre de carga
            </h3><p>
              Coordinación de rutas desde Puerto Cortés hacia Tegucigalpa y
              otros destinos nacionales.
            </p><span class="service-link"
              >Ver servicio <ArrowUpRight size={18} /></span>
          </div><div
            class="service-image road"
            aria-hidden="true"
            style={`background-image:url("${GroundTransport.src}")`}
          >
          </div></a
        >
        <a class="service-card wide light" href="/orientacion-aduanera/"
          ><div class="service-content">
            <FileCheck2 size={30} /><span class="service-index">03</span><h3>
              Orientación aduanera
            </h3><p>
              Orientación sobre documentación, trámites aduaneros y
              nacionalización de mercancías en Honduras.
            </p><span class="service-link"
              >Ver servicio <ArrowUpRight size={18} /></span>
          </div><div class="legal-lines"></div></a
        >
      </div>
    </div>
  </section>
  <section class="manifesto chapter" data-reveal-section>
    <div class="shell">
      <p data-reveal>
        Su carga no es un trámite más. Es una promesa, una inversión, un
        siguiente paso. Por eso convertimos cada documento, traslado y decisión
        en una ruta clara hacia su destino.
      </p>
    </div>
  </section>
  <section class="process chapter" id="proceso" data-process>
    <div class="shell process-grid">
      <div class="process-title" data-process-title>
        <p class="kicker">Así trabajamos</p><h2>
          Claridad en cada movimiento.
        </h2><p>
          Un acompañamiento cercano desde la primera consulta hasta la
          confirmación de entrega.
        </p><a
          class="text-link"
          href={whatsapp} data-seo-event="whatsapp_click"
          target="_blank"
          rel="noreferrer">Comenzar una consulta <ArrowUpRight size={18} /></a>
      </div><div class="process-list">
        <article>
          <span>01</span><div>
            <h3>Consulta y cotización</h3><p>
              Analizamos sus requerimientos y definimos la ruta operativa
              adecuada para su carga.
            </p>
          </div>
        </article><article>
          <span>02</span><div>
            <h3>Documentación y aduanas</h3><p>
              Preparamos y coordinamos los requisitos legales bajo las leyes
              hondureñas.
            </p>
          </div>
        </article><article>
          <span>03</span><div>
            <h3>Entrega y seguimiento</h3><p>
              Coordinamos el transporte y confirmamos la recepción en su destino
              final.
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>
  <section class="legacy chapter" id="legado">
    <div class="shell legacy-grid">
      <div class="legacy-media">
        <DottedAmericasMap />
      </div><div class="legacy-copy">
        <p class="kicker">Desde 1990</p><h2>
          Experiencia local. Visión que llega más lejos.
        </h2><p>
          Meguis es una agencia aduanera de confianza en Puerto Cortés para
          empresas que necesitan gestionar la importación, nacionalización y
          despacho de mercancías en Honduras.
        </p><ul>
          <li><Check size={17} /> Conocimiento técnico y operativo</li><li>
            <Check size={17} /> Comunicación clara durante el proceso
          </li><li><Check size={17} /> Acompañamiento de principio a fin</li>
        </ul>
      </div>
    </div>
  </section>
  <section class="testimonials chapter">
    <div class="shell testimonial-shell">
      <div class="testimonial-head">
        <p class="kicker">La confianza se entrega</p><h2>
          Historias detrás de cada carga.
        </h2>
      </div><div class="quote-stage">
        {
          testimonials.map((item, index) => (
            <blockquote
              class:list={["quote", { active: index === 0 }]}
              data-quote
            >
              <>
                <p>“{item.text}”</p>
                <footer>
                  <>
                    <span>{item.name}</span>
                    <small>Cliente de MEGUIS</small>
                  </>
                </footer>
              </>
            </blockquote>
          ))
        }
      </div><div class="testimonial-controls">
        <span data-counter>01 / 03</span><div>
          <button type="button" data-prev aria-label="Testimonio anterior"
            ><ChevronLeft size={20} /></button
          ><button type="button" data-next aria-label="Siguiente testimonio"
            ><ChevronRight size={20} /></button>
        </div>
      </div>
    </div>
  </section>
  <section class="cta chapter" id="contacto">
    <div class="shell cta-panel">
      <p class="kicker">Hablemos de su carga</p><h2>
        Su próximo movimiento empieza con una conversación.
      </h2><p>
        Cuéntenos qué necesita. Le ayudaremos a coordinar el despacho aduanero,
        transporte y logística integral desde Puerto Cortés.
      </p><a
        class="button light-button"
        href={whatsapp} data-seo-event="whatsapp_click"
        target="_blank"
        rel="noreferrer">Solicitar cotización <ArrowUpRight size={20} /></a>
    </div>
  </section>
</main>
<Footer />
<script>
  import gsap from "gsap";
  import ScrollTrigger from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);
  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    gsap.from(".hero-inner > *", {
      y: 38,
      opacity: 0,
      duration: 1,
      stagger: 0.12,
      ease: "power3.out",
      delay: 0.15,
    });
    gsap.to(".hero-media", {
      scale: 1.08,
      yPercent: 8,
      ease: "none",
      scrollTrigger: {
        trigger: ".hero",
        start: "top top",
        end: "bottom top",
        scrub: true,
      },
    });
    const words = document.querySelector<HTMLElement>("[data-reveal]");
    if (words) {
      words.innerHTML =
        words.textContent
          ?.split(" ")
          .map((word) => `<span>${word} </span>`)
          .join("") ?? "";
      gsap.fromTo(
        words.querySelectorAll("span"),
        { opacity: 0.12 },
        {
          opacity: 1,
          stagger: 0.08,
          scrollTrigger: {
            trigger: "[data-reveal-section]",
            start: "top 75%",
            end: "bottom 55%",
            scrub: 1,
          },
        },
      );
    }
    gsap.matchMedia().add("(min-width: 900px)", () => {
      ScrollTrigger.create({
        trigger: "[data-process]",
        endTrigger: ".process-list",
        start: "top 12%",
        end: "bottom bottom",
        pin: "[data-process-title]",
        pinSpacing: false,
        invalidateOnRefresh: true,
      });
      gsap.utils
        .toArray<HTMLElement>(".process-list article")
        .forEach((step) =>
          gsap.fromTo(
            step,
            { scale: 0.88, opacity: 0.2 },
            {
              scale: 1,
              opacity: 1,
              scrollTrigger: {
                trigger: step,
                start: "top 82%",
                end: "top 42%",
                scrub: 1,
              },
            },
          ),
        );
    });
  }
  const quotes = Array.from(
      document.querySelectorAll<HTMLElement>("[data-quote]"),
    ),
    counter = document.querySelector<HTMLElement>("[data-counter]");
  let current = 0;
  const show = (next: number) => {
    quotes[current]?.classList.remove("active");
    current = (next + quotes.length) % quotes.length;
    quotes[current]?.classList.add("active");
    if (counter)
      counter.textContent = `${String(current + 1).padStart(2, "0")} / ${String(quotes.length).padStart(2, "0")}`;
  };
  document
    .querySelector("[data-prev]")
    ?.addEventListener("click", () => show(current - 1));
  document
    .querySelector("[data-next]")
    ?.addEventListener("click", () => show(current + 1));
</script>
<style>
  .landing {
    --navy: #010d1c;
    --orange: #ff4b17;
    --paper: #eef1ed;
    overflow-x: hidden;
    width: 100%;
    max-width: 100%;
    background: var(--navy);
    color: #f6f7f8;
  }
  .shell {
    width: min(calc(100% - 32px), 1410px);
    margin-inline: auto;
  }
  .chapter {
    padding: clamp(7rem, 13vw, 13rem) 0;
  }
  .kicker {
    margin: 0;
    color: var(--orange);
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }
  h1,
  h2,
  h3 {
    letter-spacing: -0.045em;
  }
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    min-height: 55px;
    padding: 0 22px;
    border: 1px solid transparent;
    border-radius: 12px;
    color: #fff;
    font-size: 0.93rem;
    font-weight: 720;
    text-decoration: none;
    transition:
      transform 0.25s,
      background 0.25s;
  }
  .button:hover {
    transform: translateY(-3px);
  }
  .primary {
    background: var(--orange);
  }
  .ghost {
    border-color: #ffffff59;
    background: #010d1c33;
    backdrop-filter: blur(10px);
  }
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .hero-media {
    position: absolute;
    inset: 0;
    transform: scale(1.01);
    background: url("https://images.unsplash.com/photo-1622521186574-8276b00bdc96?q=85&w=2000&auto=format&fit=crop")
      center/cover;
    filter: saturate(0.65) contrast(1.12);
  }
  .hero-wash {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, #010d1cf5 0%, #010d1cc7 46%, #010d1c1f 100%),
      linear-gradient(0deg, #010d1cb3, transparent 45%);
  }
  .hero-inner {
    position: relative;
    z-index: 2;
    padding-top: 130px;
  }
  .location {
    margin-bottom: 25px;
    color: #fb815c;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .hero h1 {
    max-width: 1180px;
    margin-bottom: 32px;
    font-size: clamp(3.25rem, 7.2vw, 7.5rem);
    font-weight: 560;
    line-height: 0.92;
  }
  .hero h1 em {
    display: block;
    color: #ff6b3e;
    font-family: Georgia, serif;
    font-weight: 400;
  }
  .hero-copy {
    max-width: 620px;
    margin-bottom: 36px;
    color: #c5d0db;
    font-size: clamp(1rem, 1.5vw, 1.22rem);
    line-height: 1.65;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .hero-aside {
    position: absolute;
    z-index: 2;
    right: clamp(25px, 4vw, 72px);
    bottom: 48px;
    display: flex;
    gap: 22px;
    color: #ffffff94;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
  }
  .scroll-cue {
    position: absolute;
    z-index: 2;
    right: 50%;
    bottom: 24px;
    display: grid;
    width: 45px;
    height: 45px;
    place-items: center;
    transform: translateX(50%);
    border: 1px solid #ffffff40;
    border-radius: 50%;
    color: #fff;
  }
  .trust {
    padding: 42px 0;
    border-bottom: 1px solid #ffffff1a;
    background: #000914;
  }
  .trust-grid {
    display: grid;
    grid-template-columns: 1.5fr repeat(3, 1fr);
    align-items: center;
  }
  .trust-grid > p {
    max-width: 330px;
    margin: 0;
    color: #8597a8;
    font-size: 0.9rem;
    line-height: 1.6;
  }
  .trust-grid > div {
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-height: 70px;
    padding-left: clamp(20px, 4vw, 64px);
    border-left: 1px solid #ffffff21;
  }
  .trust strong {
    color: var(--orange);
    font-size: clamp(1.7rem, 3vw, 2.55rem);
    font-weight: 600;
  }
  .trust span {
    color: #a8b7c5;
    font-size: 0.69rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }
  .intro,
  .legacy {
    background: var(--paper);
    color: #071625;
  }
  .intro-grid {
    display: grid;
    grid-template-columns: 1fr 4fr;
    gap: clamp(30px, 7vw, 120px);
  }
  .intro h2 {
    max-width: 1050px;
    margin-bottom: 58px;
    font-size: clamp(2.6rem, 5vw, 5.4rem);
    font-weight: 520;
    line-height: 1.03;
  }
  .inline-image {
    display: inline-block;
    width: clamp(80px, 10vw, 160px);
    height: 0.62em;
    margin: 0 0.08em;
    vertical-align: 0.08em;
    border-radius: 999px;
    background-position: center;
    background-size: cover;
  }
  .intro-copy {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 40px;
    border-top: 1px solid #bcc5c8;
    padding-top: 28px;
  }
  .intro-copy p {
    max-width: 600px;
    margin: 0;
    color: #43515b;
    font-size: 1.06rem;
    line-height: 1.75;
  }
  .intro-copy a,
  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 13px;
    color: #071625;
    font-weight: 700;
    text-decoration: none;
  }
  .services {
    background: #001021;
  }
  .services-head {
    display: grid;
    grid-template-columns: 1fr 3fr;
    gap: 60px;
    margin-bottom: 70px;
  }
  .services-head h2 {
    max-width: 930px;
    margin: 0;
    font-size: clamp(2.6rem, 4.6vw, 5.2rem);
    font-weight: 500;
    line-height: 1.04;
  }
  .service-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-template-rows: repeat(2, minmax(255px, 1fr));
    grid-auto-flow: dense;
    gap: 1px;
    overflow: hidden;
    border-radius: 20px;
    background: #ffffff1f;
  }
  .service-card {
    position: relative;
    overflow: hidden;
    min-height: 300px;
    color: #fff;
    text-decoration: none;
    background: #0a2942;
  }
  .featured {
    grid-column: span 5;
    grid-row: span 2;
    min-height: 620px;
  }
  .wide {
    grid-column: span 7;
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
  }
  .service-content {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    padding: clamp(28px, 4vw, 58px);
  }
  .featured .service-content {
    position: absolute;
    inset: 0;
    justify-content: flex-end;
    background: linear-gradient(0deg, #010d1cf5, #010d1c05 72%);
  }
  .service-index {
    position: absolute;
    top: clamp(28px, 4vw, 58px);
    right: clamp(28px, 4vw, 58px);
    color: #9cb0bf;
    font-size: 0.75rem;
  }
  .service-card h3 {
    max-width: 520px;
    margin: 42px 0 14px;
    font-size: clamp(1.65rem, 2.8vw, 3rem);
    font-weight: 570;
    line-height: 1.04;
  }
  .service-card p {
    max-width: 530px;
    color: #b6c5d0;
    line-height: 1.65;
  }
  .service-link {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: auto;
    color: #ff754c;
    font-size: 0.86rem;
    font-weight: 700;
  }
  .service-image {
    background-position: center;
    background-size: cover;
    transition: transform 0.7s;
  }
  .service-card:hover .service-image {
    transform: scale(1.05);
  }
  .port {
    position: absolute;
    inset: 0;
    filter: grayscale(0.35) contrast(1.15);
  }
  .road {
    filter: grayscale(0.3) contrast(1.15);
  }
  .light {
    background: #e7e8e2;
    color: #061524;
  }
  .light p {
    color: #495762;
  }
  .light .service-link {
    color: #cf3b0e;
  }
  .legal-lines {
    position: relative;
    overflow: hidden;
  }
  .legal-lines:before {
    content: "";
    position: absolute;
    width: 340px;
    height: 340px;
    top: -100px;
    right: -80px;
    border: 1px solid #0716252e;
    border-radius: 50%;
    box-shadow:
      0 0 0 55px #0716250d,
      0 0 0 110px #07162508;
  }
  .manifesto {
    background: #edeee9;
    color: #071625;
  }
  .manifesto p {
    max-width: 1280px;
    margin: 0 auto;
    text-align: center;
    font-size: clamp(2.5rem, 5.7vw, 6rem);
    font-weight: 520;
    letter-spacing: -0.055em;
    line-height: 1.02;
  }
  .process {
    background: #06192b;
  }
  .process-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.35fr;
    gap: clamp(60px, 10vw, 160px);
  }
  .process-title {
    align-self: start;
    max-width: 480px;
  }
  .process-title h2 {
    margin: 24px 0;
    font-size: clamp(3rem, 5vw, 5.2rem);
    font-weight: 520;
    line-height: 0.98;
  }
  .process-title > p:not(.kicker) {
    color: #9eb0bf;
    line-height: 1.7;
  }
  .process-title .text-link {
    margin-top: 20px;
    color: #fff;
  }
  .process-list article {
    display: grid;
    grid-template-columns: 70px 1fr;
    min-height: 52vh;
    padding: 65px 0;
    border-top: 1px solid #ffffff26;
  }
  .process-list article > span {
    color: var(--orange);
