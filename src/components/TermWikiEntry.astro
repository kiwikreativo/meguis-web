---
import { ArrowLeft, ArrowUpRight, CalendarDays } from "@lucide/astro";
import Footer from "./Footer.astro";
import Layout from "../layouts/Layout.astro";
import { terms, type TermEntry } from "../data/termwiki";
import { breadcrumbSchema, businessSchema, site } from "../data/site";

interface Props { entry: TermEntry; }
const { entry } = Astro.props;
const canonical = `${site.url}/termwiki/${entry.slug}/`;
const related = entry.related.map((slug) => terms.find((term) => term.slug === slug)).filter(Boolean) as TermEntry[];
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    businessSchema,
    {
      "@type": "DefinedTerm",
      "@id": `${canonical}#term`,
      name: entry.term,
      description: entry.definition,
      inDefinedTermSet: `${site.url}/termwiki/`,
      url: canonical,
    },
    breadcrumbSchema([
      { name: "Inicio", url: `${site.url}/` },
      { name: "TermWiki", url: `${site.url}/termwiki/` },
      { name: entry.term, url: canonical },
    ]),
  ],
};
---
<Layout title={`${entry.term}: significado aduanero | MEGUIS`} description={entry.summary} canonical={canonical} structuredData={structuredData}>
  <main class="term-page" id="inicio">
    <header class="term-hero">
      <div class="shell narrow">
        <nav class="breadcrumbs" aria-label="Migas de pan"><a href="/">Inicio</a><span>/</span><a href="/termwiki/">TermWiki</a><span>/</span><span aria-current="page">{entry.term}</span></nav>
        <p class="eyebrow">TermWiki de importación y aduanas</p>
        <h1>{entry.term}</h1>
        <p class="summary">{entry.summary}</p>
      </div>
    </header>
    <article class="term-content">
      <div class="shell article-grid">
        <aside><span>Definición práctica</span><p><CalendarDays size={17} aria-hidden="true"/> Revisado: {entry.reviewed}</p></aside>
        <div class="prose">
          <p class="definition">{entry.definition}</p>
          <h2>¿Cómo se aplica en una importación?</h2>
          {entry.context.map((paragraph) => <p>{paragraph}</p>)}
          <h2>¿Cuándo encontrará este término?</h2>
          <ul>{entry.useCases.map((item) => <li>{item}</li>)}</ul>
          <div class="notice"><strong>Importante</strong><p>Esta explicación es informativa. Los requisitos y procedimientos pueden variar según la mercancía y las disposiciones vigentes; confirme su operación con la autoridad competente o con asesoría especializada.</p></div>
          <a class="service-cta" href={entry.serviceHref} data-seo-event="termwiki_to_service_click"><span>Servicio relacionado</span><strong>{entry.serviceLabel}</strong><ArrowUpRight size={22} aria-hidden="true"/></a>
        </div>
      </div>
    </article>
    <section class="related">
      <div class="shell narrow">
        <h2>Términos relacionados</h2>
        <div class="related-grid">{related.map((term) => <a href={`/termwiki/${term.slug}/`}><span>TermWiki</span><strong>{term.term}</strong><p>{term.summary}</p></a>)}</div>
        <a class="back" href="/termwiki/"><ArrowLeft size={17} aria-hidden="true"/> Ver todos los términos</a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
<style>
  .term-page{--navy:#010d1c;--paper:#eef1ed;--orange:#ff4b17;background:var(--paper);color:#071625}.shell{width:min(calc(100% - 32px),1410px);margin-inline:auto}.narrow{max-width:1120px}.term-hero{padding:clamp(9rem,16vw,13rem) 0 clamp(5rem,9vw,8rem);background:var(--navy);color:#f6f7f8}.breadcrumbs{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:clamp(3rem,6vw,5rem);color:#8094a5;font-size:.8rem}.breadcrumbs a{color:#b8c6d1;text-decoration:none}.eyebrow{margin:0 0 24px;color:var(--orange);font-size:.72rem;font-weight:750;letter-spacing:.18em;text-transform:uppercase}.term-hero h1{max-width:950px;margin:0;font-size:clamp(3.3rem,8vw,7.5rem);font-weight:520;letter-spacing:-.06em;line-height:.92}.summary{max-width:720px;margin:32px 0 0;color:#aebdca;font-size:clamp(1.05rem,1.6vw,1.3rem);line-height:1.65}.term-content{padding:clamp(5rem,10vw,9rem) 0}.article-grid{display:grid;grid-template-columns:minmax(180px,.7fr) minmax(0,2fr);gap:clamp(3rem,9vw,9rem);max-width:1120px}.article-grid aside>span{color:#bd380f;font-size:.72rem;font-weight:750;letter-spacing:.16em;text-transform:uppercase}.article-grid aside p{display:flex;align-items:center;gap:8px;margin-top:22px;color:#66727a;font-size:.8rem}.prose{max-width:760px}.prose p,.prose li{color:#43515b;font-size:1.05rem;line-height:1.8}.prose .definition{margin:0 0 4.5rem;color:#071625;font-size:clamp(1.55rem,2.6vw,2.4rem);font-weight:520;letter-spacing:-.035em;line-height:1.35}.prose h2{margin:4.5rem 0 1.4rem;font-size:clamp(2rem,3.4vw,3.3rem);font-weight:550;letter-spacing:-.045em;line-height:1.05}.prose ul{display:grid;gap:10px;padding-left:22px}.notice{margin:4rem 0;padding:28px;border-left:3px solid var(--orange);background:#e2e6e2}.notice strong{font-size:.75rem;letter-spacing:.12em;text-transform:uppercase}.notice p{margin:8px 0 0}.service-cta{display:grid;grid-template-columns:1fr auto;gap:8px 24px;padding:30px;border-radius:16px;background:#0a2942;color:#fff;text-decoration:none}.service-cta span{color:#8da4b5;font-size:.72rem;letter-spacing:.13em;text-transform:uppercase}.service-cta strong{font-size:1.2rem}.service-cta svg{grid-column:2;grid-row:1/3;align-self:center}.related{padding:clamp(5rem,10vw,9rem) 0;background:#e3e6e2}.related h2{margin:0 0 36px;font-size:clamp(2.4rem,4vw,4rem);font-weight:520;letter-spacing:-.05em}.related-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:#b8c1c1}.related-grid a{padding:28px;background:var(--paper);color:#071625;text-decoration:none}.related-grid span{color:#bd380f;font-size:.68rem;letter-spacing:.12em;text-transform:uppercase}.related-grid strong{display:block;margin:38px 0 12px;font-size:1.35rem}.related-grid p{margin:0;color:#52606a;font-size:.92rem;line-height:1.55}.back{display:inline-flex;align-items:center;gap:10px;margin-top:38px;color:#071625;font-weight:700;text-decoration:none}.term-page a:focus-visible{outline:3px solid var(--orange);outline-offset:4px}@media(max-width:760px){.article-grid{grid-template-columns:1fr;gap:2rem}.related-grid{grid-template-columns:1fr}.term-content{padding-top:4rem}.prose .definition{margin-bottom:3rem}.prose h2{margin-top:3.5rem}}@media(max-width:620px){.shell{width:min(calc(100% - 24px),1410px)}}
</style>
