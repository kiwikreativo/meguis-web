---
import { ArrowUpRight, BookOpen } from "@lucide/astro";
import Footer from "../../components/Footer.astro";
import Layout from "../../layouts/Layout.astro";
import { terms } from "../../data/termwiki";
import { breadcrumbSchema, businessSchema, site } from "../../data/site";
const canonical = `${site.url}/termwiki/`;
const description = "Diccionario práctico de términos de aduanas, importación, documentación y logística para operaciones de carga en Honduras.";
const structuredData = { "@context":"https://schema.org", "@graph":[businessSchema, breadcrumbSchema([{name:"Inicio",url:`${site.url}/`},{name:"TermWiki",url:canonical}]), {"@type":"CollectionPage","@id":`${canonical}#collection`,name:"MEGUIS TermWiki",description,url:canonical,inLanguage:"es-HN"}] };
---
<Layout title="TermWiki de Aduanas e Importación en Honduras | MEGUIS" description={description} canonical={canonical} structuredData={structuredData}>
  <main class="wiki-page" id="inicio">
    <header class="wiki-hero"><div class="shell"><p>Base de conocimiento MEGUIS</p><h1>TermWiki de aduanas e importación.</h1><div class="intro"><BookOpen size={32} stroke-width={1.5} aria-hidden="true"/><span>Conceptos prácticos para comprender la documentación, el despacho y la logística de una carga en Honduras.</span></div></div></header>
    <section class="terms"><div class="shell"><div class="section-head"><p>Explorar términos</p><h2>Entienda el proceso, concepto por concepto.</h2></div><div class="term-grid">{terms.map((term,index)=><a href={`/termwiki/${term.slug}/`}><span>{String(index+1).padStart(2,"0")}</span><h3>{term.term}</h3><p>{term.summary}</p><strong>Leer definición <ArrowUpRight size={17} aria-hidden="true"/></strong></a>)}</div></div></section>
    <section class="wiki-cta"><div class="shell"><p>¿Necesita apoyo con una operación real?</p><h2>Los conceptos ayudan. Una revisión de su carga aporta claridad.</h2><a href="/agencia-aduanera-puerto-cortes/" data-seo-event="termwiki_to_service_click">Conocer nuestros servicios <ArrowUpRight size={19} aria-hidden="true"/></a></div></section>
  </main><Footer/>
</Layout>
<style>
  .wiki-page{--navy:#010d1c;--paper:#eef1ed;--orange:#ff4b17;background:var(--paper);color:#071625}.shell{width:min(calc(100% - 32px),1410px);margin-inline:auto}.wiki-hero{padding:clamp(10rem,17vw,15rem) 0 clamp(6rem,10vw,10rem);background:var(--navy);color:#f6f7f8}.wiki-hero>div>p,.section-head>p{margin:0 0 25px;color:var(--orange);font-size:.72rem;font-weight:750;letter-spacing:.18em;text-transform:uppercase}.wiki-hero h1{max-width:1120px;margin:0;font-size:clamp(3.6rem,8.4vw,8.6rem);font-weight:510;letter-spacing:-.065em;line-height:.91}.intro{display:flex;gap:26px;max-width:710px;margin:52px 0 0 auto;padding-top:28px;border-top:1px solid #ffffff2b;color:#aebdca;font-size:1.08rem;line-height:1.65}.intro svg{flex:0 0 auto;color:#ff754c}.terms{padding:clamp(6rem,12vw,12rem) 0}.section-head{display:grid;grid-template-columns:1fr 3fr;gap:50px;margin-bottom:70px}.section-head h2{max-width:900px;margin:0;font-size:clamp(2.8rem,5vw,5.5rem);font-weight:520;letter-spacing:-.055em;line-height:1}.term-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:#aeb9bc;border:1px solid #aeb9bc}.term-grid a{display:flex;min-height:360px;flex-direction:column;padding:30px;background:var(--paper);color:#071625;text-decoration:none;transition:background .25s ease}.term-grid a:hover{background:#e3e7e3}.term-grid span{color:#bd380f;font-size:.72rem;font-weight:700}.term-grid h3{margin:65px 0 16px;font-size:clamp(1.6rem,2.3vw,2.5rem);font-weight:570;letter-spacing:-.045em;line-height:1.05}.term-grid p{margin:0;color:#53616a;line-height:1.65}.term-grid strong{display:flex;align-items:center;gap:8px;margin-top:auto;color:#bd380f;font-size:.82rem}.wiki-cta{padding:clamp(6rem,11vw,10rem) 0;background:#e76f51}.wiki-cta p{margin:0 0 24px;font-size:.75rem;font-weight:750;letter-spacing:.15em;text-transform:uppercase}.wiki-cta h2{max-width:1040px;margin:0 0 38px;font-size:clamp(3rem,6vw,6.5rem);font-weight:530;letter-spacing:-.06em;line-height:.95}.wiki-cta a{display:inline-flex;align-items:center;gap:22px;padding:17px 22px;border-radius:12px;background:#f7f4ee;color:#071625;font-weight:750;text-decoration:none}.wiki-page a:focus-visible{outline:3px solid #ff4b17;outline-offset:4px}@media(max-width:900px){.term-grid{grid-template-columns:repeat(2,1fr)}.section-head{grid-template-columns:1fr}}@media(max-width:620px){.shell{width:min(calc(100% - 24px),1410px)}.term-grid{grid-template-columns:1fr}.intro{margin-left:0}.term-grid a{min-height:310px}}
</style>
