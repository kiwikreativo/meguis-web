---
import { ArrowUpRight } from "@lucide/astro";
import Footer from "../../components/Footer.astro";
import Layout from "../../layouts/Layout.astro";
import { breadcrumbSchema, businessSchema, site } from "../../data/site";
const canonical = `${site.url}/recursos/`;
const description = "Recursos de MEGUIS para comprender las etapas de una importación, el despacho aduanero y el movimiento de carga en Honduras.";
const structuredData={"@context":"https://schema.org","@graph":[businessSchema,breadcrumbSchema([{name:"Inicio",url:`${site.url}/`},{name:"Recursos",url:canonical}]),{"@type":"CollectionPage","@id":`${canonical}#collection`,name:"Recursos para importadores",description,url:canonical,inLanguage:"es-HN"}]};
const paths=[
  {number:"01",title:"Preparar una importación",text:"Conozca los conceptos que intervienen antes de que una mercancía llegue a Honduras.",links:[{label:"Documentación aduanera",href:"/termwiki/documentacion-aduanera/"},{label:"Trámite aduanero",href:"/termwiki/tramite-aduanero/"},{label:"Asesoría aduanera",href:"/asesoria-legal-aduanera/"}]},
  {number:"02",title:"Procesar la carga",text:"Entienda qué ocurre durante el despacho y la nacionalización de mercancías.",links:[{label:"Despacho aduanero",href:"/termwiki/despacho-aduanero/"},{label:"Nacionalización",href:"/termwiki/nacionalizacion-de-mercancias/"},{label:"Servicio de despacho",href:"/despacho-aduanero/"}]},
  {number:"03",title:"Continuar hacia el destino",text:"Conecte la salida de la carga con la coordinación logística y el transporte nacional.",links:[{label:"Logística integral",href:"/termwiki/logistica-integral/"},{label:"Transporte terrestre",href:"/termwiki/transporte-terrestre-de-carga/"},{label:"Servicio de transporte",href:"/transporte-terrestre/"}]},
];
---
<Layout title="Recursos para Importadores en Honduras | MEGUIS" description={description} canonical={canonical} structuredData={structuredData}>
  <main class="resources" id="inicio"><header><div class="shell"><p>Centro de recursos</p><h1>Una ruta clara para entender su importación.</h1><span>Explore cada etapa mediante definiciones prácticas y servicios relacionados. El contenido es informativo y evita sustituir la revisión particular de su operación.</span></div></header><section><div class="shell"><div class="paths">{paths.map(path=><article><span>{path.number}</span><div><h2>{path.title}</h2><p>{path.text}</p></div><nav aria-label={`Recursos sobre ${path.title}`}>{path.links.map(link=><a href={link.href} data-seo-event={link.href.startsWith("/termwiki")?undefined:"resource_to_service_click"}>{link.label}<ArrowUpRight size={17} aria-hidden="true"/></a>)}</nav></article>)}</div><div class="all-terms"><p>¿Busca un concepto específico?</p><a href="/termwiki/">Explorar todo el TermWiki <ArrowUpRight size={18} aria-hidden="true"/></a></div></div></section></main><Footer/>
</Layout>
<style>
  .resources{--navy:#010d1c;--paper:#eef1ed;--orange:#ff4b17;background:var(--paper);color:#071625}.shell{width:min(calc(100% - 32px),1410px);margin-inline:auto}.resources header{padding:clamp(10rem,17vw,15rem) 0 clamp(6rem,10vw,9rem);background:var(--navy);color:#fff}.resources header p{margin:0 0 25px;color:var(--orange);font-size:.72rem;font-weight:750;letter-spacing:.18em;text-transform:uppercase}.resources h1{max-width:1100px;margin:0;font-size:clamp(3.4rem,8vw,8.2rem);font-weight:510;letter-spacing:-.065em;line-height:.92}.resources header span{display:block;max-width:680px;margin:46px 0 0 auto;color:#aebdca;font-size:1.08rem;line-height:1.7}.resources>section{padding:clamp(6rem,11vw,11rem) 0}.paths{border-top:1px solid #aeb9bc}.paths article{display:grid;grid-template-columns:80px 1.25fr 1fr;gap:clamp(25px,5vw,70px);padding:clamp(38px,6vw,72px) 0;border-bottom:1px solid #aeb9bc}.paths article>span{color:#bd380f;font-size:.75rem;font-weight:750}.paths h2{margin:0 0 16px;font-size:clamp(2rem,3.5vw,3.8rem);font-weight:540;letter-spacing:-.05em;line-height:1}.paths p{max-width:520px;margin:0;color:#52606a;line-height:1.7}.paths nav{display:flex;flex-direction:column}.paths a{display:flex;align-items:center;justify-content:space-between;padding:15px 0;border-bottom:1px solid #c7cecc;color:#071625;font-weight:700;text-decoration:none}.paths a:hover{color:#bd380f}.all-terms{display:flex;align-items:center;justify-content:space-between;margin-top:70px;padding:38px;border-radius:16px;background:#0a2942;color:#fff}.all-terms p{margin:0;color:#9fb0bd}.all-terms a{display:flex;align-items:center;gap:12px;color:#fff;font-weight:750;text-decoration:none}.resources a:focus-visible{outline:3px solid var(--orange);outline-offset:4px}@media(max-width:760px){.paths article{grid-template-columns:40px 1fr}.paths nav{grid-column:2}.all-terms{align-items:flex-start;flex-direction:column;gap:20px}}@media(max-width:620px){.shell{width:min(calc(100% - 24px),1410px)}}
</style>
