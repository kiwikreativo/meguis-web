---
import { ArrowLeft } from "@lucide/astro";
import Layout from "../layouts/Layout.astro";
---
<Layout title="Página no encontrada | MEGUIS" description="La página solicitada no está disponible." canonical="https://www.meguis.net/404/" noindex={true}><main><p>Error 404</p><h1>Esta ruta no llegó a destino.</h1><span>Puede regresar al inicio o explorar nuestros recursos para importadores.</span><div><a href="/"><ArrowLeft size={18} aria-hidden="true"/> Volver al inicio</a><a href="/recursos/">Explorar recursos</a></div></main></Layout>
<style>main{display:flex;min-height:100svh;flex-direction:column;justify-content:center;padding:clamp(8rem,14vw,13rem) max(24px,calc((100vw - 1410px)/2));background:#010d1c;color:#fff}p{margin:0 0 24px;color:#ff4b17;font-size:.72rem;font-weight:750;letter-spacing:.18em;text-transform:uppercase}h1{max-width:1000px;margin:0;font-size:clamp(3.5rem,8vw,8rem);font-weight:520;letter-spacing:-.065em;line-height:.92}span{max-width:600px;margin-top:32px;color:#aebdca;font-size:1.08rem;line-height:1.7}div{display:flex;flex-wrap:wrap;gap:14px;margin-top:38px}a{display:flex;align-items:center;gap:10px;padding:16px 20px;border:1px solid #ffffff4a;border-radius:12px;color:#fff;font-weight:700;text-decoration:none}a:first-child{border-color:#ff4b17;background:#ff4b17;color:#010d1c}a:focus-visible{outline:3px solid #fff;outline-offset:4px}</style>
